<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SangueDoceApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/navi</item>
        <item name="colorSecondary">@color/azure</item>

        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/status_bar_background</item>
        <!-- A barra é escura, portanto os ícones do sistema devem ser claros. -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Customize your theme here. -->
    </style>


    <style name="Theme.SangueDoceApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navi</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/sangue_doce</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/navi</item>
        <item name="postSplashScreenTheme">@style/Theme.SangueDoceApp</item>
    </style>
</resources>
